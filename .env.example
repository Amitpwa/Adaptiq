# ---------------------------------------------------------------------------
# Adaptiq environment contract
# Copy to `.env` and fill in there. NEVER put real credentials in this file:
# .env.example is committed to version control, .env is not.
# Every variable here is SERVER-ONLY except those prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Neon: use the POOLED connection string (host contains "-pooler") for runtime.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-PROJECT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon: the DIRECT (non-pooled) connection string. Migrations must not run
# through PgBouncer transaction pooling, so this must be the non-pooled host.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-PROJECT.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Authentication (required) ---------------------------------------------
# Generate with: openssl rand -base64 32   (or `npx auth secret`)
AUTH_SECRET=""

# Canonical origin of the deployment. http://localhost:3000 in development.
AUTH_URL="http://localhost:3000"

# AES-256-GCM master key for encrypting learner-supplied LLM API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this invalidates every stored key and learners must reconnect.
ENCRYPTION_KEY=

# --- AI (optional) ---------------------------------------------------------
# A DEPLOYMENT-WIDE fallback key. Learners can connect their own key instead,
# which takes precedence. With neither, Adaptiq runs in deterministic mode:
# curated content and the database-backed Socratic hint ladder. That is a
# supported, tested path — not a broken one.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
AI_TIMEOUT_MS="3500"

# --- Community tier: free, open-source models (optional) -------------------
# Serves open-weights models (Llama 3.3, Qwen 2.5, Mistral) at no cost so that
# learners without their own key still get generative explanations.
#
# Vercel has no GPU and a hard bundle limit, so open weights cannot be hosted
# in-process; they are reached through an OpenAI-compatible gateway. Get a free
# key at https://openrouter.ai/keys and use a model id ending in ":free".
# Works with any OpenAI-compatible endpoint: Groq, Together, DeepInfra, Ollama.
COMMUNITY_LLM_API_KEY=""
COMMUNITY_LLM_BASE_URL="https://openrouter.ai/api/v1"
COMMUNITY_LLM_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# --- Public (safe to expose to the browser) --------------------------------
NEXT_PUBLIC_APP_NAME="Adaptiq"
