# ---------------------------------------------------------------------------
# Adaptiq environment contract
# Copy to `.env` and fill in. Never commit `.env`.
# Every variable here is SERVER-ONLY except those prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Neon: use the POOLED connection string (host contains "-pooler") for runtime.
# Local Docker: postgresql://adaptiq:adaptiq@localhost:5432/adaptiq?schema=public
DATABASE_URL="postgresql://user:password@host/adaptiq?sslmode=require"

# Neon: the DIRECT (non-pooled) connection string. Migrations must not run
# through PgBouncer transaction pooling. Locally this is the same as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host/adaptiq?sslmode=require"

# --- Authentication (required) ---------------------------------------------
# Generate with: openssl rand -base64 32   (or `npx auth secret`)
AUTH_SECRET=""

# Canonical origin of the deployment. http://localhost:3000 in development.
AUTH_URL="http://localhost:3000"

# --- AI (optional) ---------------------------------------------------------
# Absent or invalid => Adaptiq runs in deterministic mode: curated content and
# the database-backed Socratic hint ladder. This is a supported, tested path.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
AI_TIMEOUT_MS="3500"

# --- Public (safe to expose to the browser) --------------------------------
NEXT_PUBLIC_APP_NAME="Adaptiq"
